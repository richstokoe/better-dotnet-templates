{
    "$schema": "http://json.schemastore.org/template",
    "author": "Rich Stokoe",
    "classifications": [ "Web", "Mvc", "Razor Pages" ],
    "identity": "RichStokoe.BetterTemplates.HybridReactSpaWithMVCBackEndProject",
    "name": "React TypeScript front end with MVC back end with Feature Slices",
    "shortName": "better-hybrid",
    "sourceName":"HybridReactSpaWithMVCBackEnd",
    "tags": {
      "language": "C#",
      "type": "project"
    },
    "symbols": {
      "Framework": {
        "type": "parameter",
        "description": "The target framework for the project.",
        "datatype": "choice",
        "choices": [
          { "choice": "net8.0", "description": ".NET 8 (LTS)" },
          { "choice": "net9.0", "description": ".NET 9" },
          { "choice": "net10.0", "description": ".NET 10 (LTS)" }
        ],
        "defaultValue": "net10.0",
        "replaces": "net$(targetframeworkversion)"
      }
    }
  }